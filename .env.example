# ============================================================
# Insurance Foresight Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to git.
# ============================================================

# Required: Your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: Which model to use for all LLM calls
# Recommended: gpt-4o (best quality) or gpt-4o-mini (faster, cheaper)
OPENAI_MODEL=gpt-4o

# Optional: Directory where output files (CSV, JSON) will be saved
# Default: output/
OUTPUT_DIR=output

# Optional: Maximum number of candidate ventures to generate per query
# Default: 10
MAX_CANDIDATES=10

# Optional: Tavily API key for web search (v0.2 — search-grounded discovery)
# Get a free API key at https://tavily.com
# When set: Scout uses real web search results → much less hallucination
# When not set: Scout falls back to LLM-only mode (v0.1 behavior)
TAVILY_API_KEY=tvly-...
